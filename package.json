{
  "name": "defcalendar",
  "version": "0.10.8",
  "description": "Desktop calendar app for Microsoft 365 Exchange Online built with Electron.",
  "author": "Daniel",
  "main": "out/main/index.cjs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "dist:publish": "electron-vite build && electron-builder --publish always",
    "lint": "oxlint --tsconfig tsconfig.json src test electron.vite.config.ts",
    "lint:fix": "oxlint --tsconfig tsconfig.json --fix src test electron.vite.config.ts",
    "format": "oxfmt --write src test electron.vite.config.ts",
    "format:check": "oxfmt --check src test electron.vite.config.ts",
    "audit": "npm audit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "electron-builder install-app-deps",
    "prepare": "husky"
  },
  "build": {
    "appId": "com.daniel.defcalendar",
    "productName": "DefCalendar",
    "icon": "resources/logo.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert"
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xBounceIT",
        "repo": "DefCalendar",
        "releaseType": "draft"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@azure/msal-node": "^7.1.2",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@tanstack/react-query": "^5.100.6",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.3.4",
    "i18next": "^26.0.8",
    "pathe": "^2.0.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.6",
    "zod": "^4.6.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "electron": "^42.11.16",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@electron/asar": "^4.2.0",
    "@electron/get": {
      "undici": "^7.30.1",
      "global-agent": "^4.1.3"
    },
    "@electron/universal": "^3.0.4",
    "boolean": "file:vendor/npm/boolean",
    "brace-expansion": "^5.0.9",
    "dir-compare": "^5.0.0",
    "ejs": "^3.1.10",
    "filelist": "^2.0.1",
    "glob": "^14.0.3",
    "jake": "^11.9.5",
    "jsdom": {
      "undici": "^7.30.1"
    },
    "js-yaml": "^4.3.1",
    "lodash.isequal": "file:vendor/npm/lodash.isequal",
    "minimatch": "^11.0.4",
    "nanoid": "^3.3.18",
    "node-gyp": "^12.2.0",
    "postcss": "^8.5.26",
    "prebuild-install": "npm:@scrypted/prebuild-install@7.1.10",
    "rimraf": "^6.1.4",
    "tar": "^7.5.22",
    "temp": "^0.9.4",
    "vite": {
      "esbuild": "^0.28.1"
    },
    "http-cache-semantics": "^4.3.0",
    "source-map-js": "^1.2.2",
    "oxfmt": {
      "tinypool": "^2.1.2"
    }
  }
}
